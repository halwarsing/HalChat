<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Линейный градиент (фон) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#0E0F14"
                android:endColor="#131622"/>
        </shape>
    </item>

    <!-- Радужное пятно розовое -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="900px"
                android:centerX="18%"
                android:centerY="20%"
                android:startColor="#29FE007E"
                android:endColor="#00FE007E" />
        </shape>
    </item>

    <!-- Радужное пятно синее -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="1100px"
                android:centerX="82%"
                android:centerY="22%"
                android:startColor="#293A01FF"
            android:endColor="#003A01FF"/>
        </shape>
    </item>

    <!-- Радужное пятно белое -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="1000px"
                android:centerX="22%"
                android:centerY="82%"
                android:startColor="#0FFFFFFF"
            android:endColor="#00FFFFFF"/>
        </shape>
    </item>

</layer-list>
