<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    tools:context=".main.ChatActivity"
    android:fitsSystemWindows="true">
            <include
                android:id="@+id/toolbar"
                layout="@layout/chat_toolbar_layout"/>

            <!-- Messages -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/messages_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:paddingStart ="5dp"
                android:paddingEnd="5dp"
                android:background="@drawable/gradient_background_selector"/>

        <!-- Поле ввода и кнопка отправки -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:background="@color/thirdBackground">
            <LinearLayout
                android:id="@+id/answerDiv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/fourthBackground"
                android:visibility="gone">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_pluschat"
                    android:background="@drawable/zero"
                    android:scaleType="fitCenter"
                    android:padding="5dp"/>
                <LinearLayout
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:focusable="false"
                    android:clickable="false">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/answerDivNickname"
                        android:text="@string/app_name"
                        android:textSize="@dimen/tinyText"
                        android:clickable="false"
                        android:focusable="false"/>
                    <TextView
                        android:id="@+id/answerDivText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textSize="@dimen/standardText"
                        android:clickable="false"
                        android:focusable="false"/>
                </LinearLayout>
                <ImageButton
                    android:id="@+id/closeAnswerDiv"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:background="@drawable/zero"
                    android:layout_gravity="center_vertical"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/recording_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:visibility="gone"
                android:padding="8dp">

                <TextView
                    android:id="@+id/timer_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/zeroTime"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:textColor="@android:color/white"/>

                <ImageButton
                    android:id="@+id/pause_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_pause"/>

                <ImageButton
                    android:id="@+id/delete_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="3dp"
                    android:src="@drawable/ic_delete"/>

                <ImageButton
                    android:id="@+id/send_record_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_send"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:paddingEnd="5dp"
                android:paddingStart="8dp"
                android:gravity="start"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:visibility="visible"
                android:id="@+id/message_input_div">
                <EditText
                    android:id="@+id/message_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/type_message"
                    android:inputType="textMultiLine"
                    android:background="@drawable/round_input"
                    android:padding="8dp"
                    android:gravity="top|start"
                    android:scrollbars="vertical"
                    android:overScrollMode="always"
                    android:minLines="1"
                    android:maxLines="5"
                    android:scrollHorizontally="false"
                    />

                <ImageButton
                    android:id="@+id/menu_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_more_send"
                    android:layout_marginStart="3dp"/>

                <ImageButton
                    android:id="@+id/send_button"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginStart="1dp"
                    android:src="@drawable/ic_microphone"/>
            </LinearLayout>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:id="@+id/attachmentsSend">
                </LinearLayout>
            </HorizontalScrollView>
            <!-- Меню эмодзи (изначально скрыто) -->
            <LinearLayout
                android:id="@+id/emoji_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/background"
                android:elevation="10dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/emojisSelectBtn"
                        android:text="@string/emojis"/>
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:id="@+id/pixelsSelectBtn"
                        android:text="@string/pixels"/>
                </LinearLayout>

                <!-- Категории эмодзи -->
                <!-- <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/secondBackground"
                    android:padding="8dp">

                    <LinearLayout
                        android:id="@+id/emoji_categories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView> -->

                <!-- Сетка с эмодзи -->
                <GridView
                    android:id="@+id/emoji_grid"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:numColumns="6"
                    android:verticalSpacing="8dp"
                    android:horizontalSpacing="8dp"
                    android:padding="8dp"
                    android:scrollbars="vertical"
                    android:visibility="visible"/>
                <GridView
                    android:id="@+id/pixel_grid"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:numColumns="3"
                    android:verticalSpacing="1dp"
                    android:horizontalSpacing="1dp"
                    android:padding="8dp"
                    android:scrollbars="vertical"
                    android:visibility="gone"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/poll_menu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/background"
                android:elevation="10dp"
                android:visibility="gone">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_poll_menu_add"
                        android:text="@string/poll_menu_add"/>
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:id="@+id/btn_poll_menu_remove"
                        android:text="@string/poll_menu_remove"/>
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/poll_menu_variants"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/poll_menu_variant_1"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="@string/poll_menu_variant_2"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_3"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_4"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_5"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_6"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_7"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_8"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_9"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_10"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_11"/>
                    <EditText
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:visibility="gone"
                        android:hint="@string/poll_menu_variant_12"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
</LinearLayout>