<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/videoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"/>

    <ImageButton
        android:id="@+id/videoClose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:background="@drawable/file_action_background"
        android:contentDescription="@string/message_search_close"
        android:src="@drawable/ic_close"/>

    <LinearLayout
        android:id="@+id/videoControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="12dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:background="#99000000">
        <ImageButton
            android:id="@+id/videoPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/video_play_pause"
            android:src="@drawable/ic_file_pause"/>

        <TextView
            android:id="@+id/videoTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:text="0:00"
            android:textColor="@color/white"
            android:textSize="13sp"/>

        <!-- Стандартный SeekBar темы Material крупный и вырезает зазор вокруг ползунка -->
        <SeekBar
            android:id="@+id/videoSeek"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:layout_weight="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:minHeight="3dp"
            android:maxHeight="3dp"
            android:background="@null"
            android:splitTrack="false"
            android:progressDrawable="@drawable/video_seek_progress"
            android:thumb="@drawable/video_seek_thumb"/>

        <TextView
            android:id="@+id/videoDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="40dp"
            android:gravity="end"
            android:text="0:00"
            android:textColor="@color/white"
            android:textSize="13sp"/>
    </LinearLayout>
</FrameLayout>
